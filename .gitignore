# ---- 环境与依赖 ----
.venv/
.wheels/
.tmp/
tmp_pip/
.cache/
.env
__pycache__/
*.pyc

# ---- 数据库（体积大且可重建）----
data/askdata.duckdb
data/askdata.duckdb.wal
data/_timeout_test_*.duckdb
data/_timeout_test_*.duckdb.wal

# ---- 浏览器调试产物 ----
.edge-profile*/
tmp_acceptance/

# ---- 截图 ----
# 只忽略散落在根目录的临时截图。
# 不要写成裸的 *.png —— 那会把 docs/ 里的文档图一起干掉，README 会全裂。
/*.png

# 截图脚本一次生成 12 张（6 页 × 日夜），仓库里只保留 README 引用的 5 张
docs/shots/*
!docs/shots/ask-light.png
!docs/shots/eval-light.png
!docs/shots/dict-light.png
!docs/shots/guard-light.png
!docs/shots/ask-dark.png
!docs/shots/key-panel.png
!docs/shots/settings-light.png
!docs/shots/api-docs.png
!docs/shots/mobile.png
!docs/shots/mobile-360.png
# 运行产物：日志、PID、临时诊断文件
/*.log
/*.err
/.server.pid
# 注意：不要写 /*.txt —— 会连 requirements.txt 一起忽略掉。
# 表现是 CI 里 `pip install -r requirements.txt` 找不到文件、10 秒内失败，
# 而且从报错里完全看不出是 .gitignore 干的。
/perr.txt
/plog.txt
/s8799.log
/s8799.err
# 本地草稿：不随仓库发布
docs/draft-*
scripts/make_docs_personal.py

# ---- 工具缓存与产物 ----
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
